# ====== Database
DB_STRING=mongodb+srv://user:password@cluster.mongodb.net/airbnb?appName=Cluster0

# ====== Auth
JWT_TOKEN=replace-with-a-long-random-string

# ====== Email (Gmail app password, not the account password)
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password

# ====== Cloudinary (image hosting)
CLAUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SEC=your-api-secret

# ====== Stripe
# Payments and payouts stay disabled and return 503 until these are set.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ====== URLs
# Where the browser app is served from. Stripe redirects back here.
CLIENT_URL=http://localhost:5173
# Extra browser origins allowed by CORS, comma separated.
# Required in production, otherwise the deployed frontend is blocked.
CLIENT_ORIGINS=

# ====== Optional
PORT=8000
# Commission taken from each booking, as a percent.
PLATFORM_FEE_PERCENT=12
# Set to the number of proxies in front of the app (1 behind nginx or an ALB),
# so rate limiting reads the real client IP.
TRUST_PROXY=
